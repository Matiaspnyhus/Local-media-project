# built program
/localmedia
/localmedia.exe
/release/

# web app: dependencies and build output (the build is embedded at compile time)
web/node_modules/
web/dist/*
!web/dist/.gitkeep
e2e/node_modules/

# never commit anything from a real home: data folders, bundles, logs
*.db
*.db-wal
*.db-shm
!internal/db/testdata/*.db
localmedia-support-*.zip
*.log
/installer/
/package/

# helpers' working copies made by the build tooling; never part of the project
/.claude/
